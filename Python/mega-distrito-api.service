[Unit]
Description=Mega Distrito API (gunicorn)
After=network.target mysql.service

[Service]
Type=simple
User=felipe
WorkingDirectory=/var/www/mega-distrito/Python
EnvironmentFile=/var/www/mega-distrito/Python/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/var/www/mega-distrito/Python/venv/bin/gunicorn -w 4 -b 127.0.0.1:5000 wsgi:app
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
